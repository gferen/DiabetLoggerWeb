# All optional. Uncomment / set what you need.

# --- Browser login (both required to enable) ---
#DIABET_USERNAME=gregor
#DIABET_PASSWORD=change-me-long-passphrase

# --- API key for scripts/curl (X-API-Key header) ---
#DIABET_API_KEY=some-long-random-string

# --- Advanced ---
#DIABET_JWT_SECRET=              # auto-generated if empty
#DIABET_TOKEN_TTL_DAYS=30

# --- Juggluco (CGM sync, juggluco_pull.py) ---
#JUGGLUCO_HOST=192.168.x.x          # phone running Juggluco, reachable over WireGuard
#JUGGLUCO_PORT=17580
#JUGGLUCO_API_SECRET=               # Juggluco api_secret; the pull script reuses DIABET_API_KEY
